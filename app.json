{
  "expo": {
    "name": "Tres en Raya Móvil",
    "slug": "broma-phone-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon-512.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f19",
    "splash": {
      "backgroundColor": "#0b0f19",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19"
      },
      "package": "com.broma.phone.tresenraya",
      "versionCode": 1,
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./public/icon-192.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
